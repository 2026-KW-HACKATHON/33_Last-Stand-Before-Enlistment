FROM eclipse-temurin:17-jdk-jammy AS build
WORKDIR /workspace
COPY gradlew settings.gradle build.gradle ./
COPY gradle ./gradle
COPY src ./src
RUN chmod +x gradlew && ./gradlew --no-daemon bootJar

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app
RUN useradd --uid 10001 --create-home discushion
COPY --from=build /workspace/build/libs/discushion.jar /app/discushion.jar
USER discushion
ENV PORT=8080
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/discushion.jar"]
