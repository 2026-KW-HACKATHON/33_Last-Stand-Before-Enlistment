# Copy to backend/.env. Spring loads this file when started from backend/.
# Do not commit real secrets. Keep local for the database-free Health Check.
SPRING_PROFILES_ACTIVE=local
PORT=8080

# To use Supabase, set SPRING_PROFILES_ACTIVE=supabase and replace placeholders.
# Copy the transaction pooler host/user from the Supabase project's Connect UI.
# Download the official Supabase root CA and supply its real local path.
# verify-full validates both the certificate chain and the server hostname.
# prepareThreshold=0 disables prepared statements for transaction pooling.
# Never disable certificate verification to work around a connection error.
DB_URL=jdbc:postgresql://<pooler-host>:6543/postgres?sslmode=verify-full&sslrootcert=<root-certificate-path>&prepareThreshold=0&connectTimeout=10&socketTimeout=30
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>
DB_POOL_SIZE=1

# #30 proposal: after the reviewed migration and separate password/LOGIN setup,
# the Spring runtime uses discushion_server.<project-ref> on the shared pooler.
# Until actual provisioning/verification, keep the existing connection unchanged.
# Optional TEST-ONLY admin credentials for the 3 SELECT-only Supabase audit tests.
# The runtime account must not receive migration-history/legacy access for audits.
# DB_AUDIT_USERNAME=postgres.<project-ref>
# DB_AUDIT_PASSWORD=<admin-password-kept-only-in-local-secret>

# Service variables use project conventions, not automatic provider settings.
# Privy: use the same real app as FE. The ID selects the access-token audience
# and official app JWKS. Never use an identity token in place of an access token.
PRIVY_APP_ID=<privy-app-id>
# Required for #6/#7 verified email lookup via Privy's server user API.
# JWT verification via JWKS alone does not require the secret.
# Keep this in backend/.env and the approved server deployment secret only.
PRIVY_APP_SECRET=<server-only-privy-app-secret>

SUPABASE_URL=https://<project-ref>.supabase.co
# Server-only privileged key. Never copy into frontend/public variables.
SUPABASE_SECRET_KEY=<server-only-supabase-secret-key>
# Actual bucket must be created/confirmed in #13/#30.
SUPABASE_STORAGE_BUCKET=<post-photo-bucket>

# #13 relay remains disabled until the new migration, server DB permissions,
# real Storage lifecycle and deployment 10MB/body limits are verified in #30.
PHOTO_UPLOADS_ENABLED=false
PHOTO_STORAGE_WIRE_VERIFIED=false
# Relay admission uses the DB clock and does not issue signed upload URLs.
PHOTO_CLEANUP_ENABLED=false
PHOTO_CLEANUP_INTERVAL_MS=60000

GEMINI_API_KEY=<server-only-gemini-api-key>
# Confirmed official API model; verify this environment/key before enabling.
GEMINI_MODEL=gemini-3.5-flash-lite

# Enable only after actual provider/key verification; defaults to source fallback.
AI_SUMMARIES_ENABLED=false
