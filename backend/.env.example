# Copy to backend/.env. Spring loads this file when started from backend/.
# Do not commit real secrets. Keep local for the database-free Health Check.
SPRING_PROFILES_ACTIVE=local
PORT=8080

# To use Supabase, set SPRING_PROFILES_ACTIVE=supabase and replace placeholders.
# Copy the transaction pooler host/user from the Supabase project's Connect UI.
# Download the official Supabase root CA and supply its real local path.
# verify-full validates both the certificate chain and the server hostname.
# prepareThreshold=0 disables prepared statements for transaction pooling.
# Never disable certificate verification to work around a connection error.
DB_URL=jdbc:postgresql://<pooler-host>:6543/postgres?sslmode=verify-full&sslrootcert=<root-certificate-path>&prepareThreshold=0&connectTimeout=10&socketTimeout=30
DB_USERNAME=<database-user>
DB_PASSWORD=<database-password>
DB_POOL_SIZE=1
