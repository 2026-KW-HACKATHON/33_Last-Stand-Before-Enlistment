# User-confirmed API including its prefix. Used by the single root ApiClient.
NEXT_PUBLIC_API_BASE_URL=https://discushion-api.onrender.com/api/v1
# Public Privy application ID, same app as backend PRIVY_APP_ID.
# Configure Email OTP and exact FE origins in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=
# NEXT_PUBLIC_ values are browser-visible. Never place secrets or tokens here.
